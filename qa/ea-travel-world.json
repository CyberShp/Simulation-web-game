  "logs": [
    {
      "time": 120,
      "text": "掌门亲往「青溪坊市」。"
    },
    {
      "time": 120,
      "text": "山中转为灵露：灵气凝露，药圃与悟道均受滋养。"
    },
    {
      "time": 110,
      "text": "整理出《春雨养脉法》与旧商路信笺。青溪坊市、石桥驿与听雨遗址均有可追查之处。"
    },
    {
      "time": 110,
      "text": "藏经阁落成，门人会自行权衡是否使用。"
    },
    {
      "time": 71,
      "text": "林长风初步掌握《青岚养元诀》，还需继续熟悉才能授业。"
    },
    {
      "time": 68,
      "text": "陆知微初步掌握《青岚养元诀》，还需继续熟悉才能授业。"
    },
    {
      "time": 20,
      "text": "林长风来到山院，希望在这里得到安身与求道的机会。"
    },
    {
      "time": 20,
      "text": "林长风愿意留下，共同生活与求道。"
    },
    {
      "time": 20,
      "text": "灵稻田落成，门人会自行权衡是否使用。"
    },
    {
      "time": 20,
      "text": "伐木场落成，门人会自行权衡是否使用。"
    },
    {
      "time": 20,
      "text": "灵草田落成，门人会自行权衡是否使用。"
    },
    {
      "time": 20,
      "text": "陆知微因赠药之恩留下。她愿经营药圃，并不因此承诺参与复仇。"
    },
    {
      "time": 20,
      "text": "陆知微愿意留下，共同生活与求道。"
    },
    {
      "time": 20,
      "text": "伤势渐平，根基未损。母亲留下的药理仍能救人。"
    },
    {
      "time": 15,
      "text": "伤势已愈，逃亡并未永久损伤天资。"
    },
    {
      "time": 0,
      "text": "栖霞一夜成灰。你携残存传承来到云岫别院，父母留下的最后一句话是：活下去。"
    }
  ],
