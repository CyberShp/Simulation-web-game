  "logs": [
    {
      "time": 245,
      "text": "掌门从云岫山谷归来。已取得的证据与收获均保留。"
    },
    {
      "time": 245,
      "text": "照应迷路行人已完成：交出口粮，结下善缘并获赠实用药材。 本次灵露的收获已经带在身上。"
    },
    {
      "time": 243,
      "text": "抵达云岫山谷。在地图中走近溪边药径，再选择查访行动。"
    },
    {
      "time": 240,
      "text": "行脚药师来到山门，等待你的回应。"
    },
    {
      "time": 240,
      "text": "山中转为长风：风干土壤，采石与伐木需要更多照应。"
    },
    {
      "time": 240,
      "text": "陆知微初步掌握《春雨养脉法》，还需继续熟悉才能授业。"
    },
    {
      "time": 231,
      "text": "掌门亲往「云岫山谷」。"
    },
    {
      "time": 223,
      "text": "掌门公布「侧重灵草」，门人会按人格、需要与经历重新权衡。"
    },
    {
      "time": 222,
      "text": "灵稻田营造完成，入口连通，门人可自主前来使用。"
    },
    {
      "time": 180,
      "text": "游方讲师来访：「一席论道」。"
    },
    {
      "time": 178,
      "text": "灵稻田开始备料，掌门须到场营造；材料已预留。"
    },
    {
      "time": 178,
      "text": "沈砚初步掌握《春雨养脉法》的理解（20）。"
    },
    {
      "time": 140,
      "text": "掌门开始研习《春雨养脉法》，需投入约38秒。"
    },
    {
      "time": 140,
      "text": "整理出《春雨养脉法》与旧商路信笺。青溪坊市、石桥驿与听雨遗址均有可追查之处。"
    },
    {
      "time": 139,
      "text": "藏经阁营造完成，入口连通，门人可自主前来使用。"
    },
    {
      "time": 131,
      "text": "林长风初步掌握《青岚养元诀》，还需继续熟悉才能授业。"
    },
    {
      "time": 120,
      "text": "山中转为灵露：灵气凝露，药圃与悟道均受滋养。"
    },
    {
      "time": 120,
      "text": "林长风提出一桩心事：「一卷心愿」。可在门人事务中听取。"
    },
    {
      "time": 120,
      "text": "陆知微提出一桩心事：「山下家书」。可在门人事务中听取。"
    },
    {
      "time": 109,
      "text": "藏经阁开始备料，掌门须到场营造；材料已预留。"
    },
    {
      "time": 79,
      "text": "林长风自愿留下，原来的身份、外观与经历一并保留。"
    },
    {
      "time": 67,
      "text": "伐木场营造完成，入口连通，门人可自主前来使用。"
    },
    {
      "time": 63,
      "text": "陆知微初步掌握《青岚养元诀》，还需继续熟悉才能授业。"
    },
    {
      "time": 45,
      "text": "伐木场开始备料，掌门须到场营造；材料已预留。"
    },
    {
      "time": 44,
      "text": "灵草田营造完成，入口连通，门人可自主前来使用。"
    },
    {
      "time": 15,
      "text": "灵草田开始备料，掌门须到场营造；材料已预留。"
    },
    {
      "time": 15,
      "text": "陆知微自愿入院研习药理。赠药、入院和参与复仇各是一次选择。"
    },
    {
      "time": 15,
      "text": "赠出十份灵草。陆知微谢过救命之情，尚未承诺入院或同行。"
    },
    {
      "time": 15,
      "text": "伤势渐平，根基未损。母亲留下的药理仍能救人。"
    },
    {
      "time": 15,
      "text": "伤势已愈，逃亡并未永久损伤天资。"
    },
    {
      "time": 0,
      "text": "林长风愿意留下，共同生活与求道。"
    },
    {
      "time": 0,
      "text": "栖霞一夜成灰。你携残存传承来到云岫别院，父母留下的最后一句话是：活下去。"
    }
  ],
