; 模拟仙府 — Web development project. Prepare assets with tools/build-godot-web.py.
config_version=5

[application]
config/name="模拟仙府 · 余烬立山"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[gui]
theme/custom_font="res://assets/assets/fonts/xianfu-brush.woff2"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.16, 0.21, 0.17, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false
